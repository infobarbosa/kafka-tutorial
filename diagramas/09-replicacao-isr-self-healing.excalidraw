   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "3. Self-Healing (broker-start 2 e 3)",
   "originalText": "3. Self-Healing (broker-start 2 e 3)",
   "fontSize": 15.5,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.28,
   "autoResize": true
  },
  {
   "id": "text-37",
   "type": "text",
   "x": 882,
   "y": 434,
   "width": 284.3,
   "height": 138.2,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1577358997,
   "version": 1,
   "versionNonce": 1577364137,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Brokers voltam e fazem CATCH-UP\nautomatico copiando offsets do lider.\n\nISR volta para [1, 2, 3]!\nProdutor entrega a fila em buffer\nsem duplicatas (enable.idempotence).\n\nResultado: recuperacao 100% automatica!",
   "originalText": "Brokers voltam e fazem CATCH-UP\nautomatico copiando offsets do lider.\n\nISR volta para [1, 2, 3]!\nProdutor entrega a fila em buffer\nsem duplicatas (enable.idempotence).\n\nResultado: recuperacao 100% automatica!",
   "fontSize": 13.5,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.28,
   "autoResize": true
  },
