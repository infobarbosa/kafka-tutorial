   "link": null,
   "locked": false
  },
  {
   "id": "text-33",
   "type": "text",
   "x": 487.7,
   "y": 392,
   "width": 284.6,
   "height": 19.8,
   "angle": 0,
   "strokeColor": "#c92a2a",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
