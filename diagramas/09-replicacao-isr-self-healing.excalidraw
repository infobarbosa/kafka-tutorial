   "versionNonce": 1697027053,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "2. Cai o 2o broker (broker-kill 2)",
   "originalText": "2. Cai o 2o broker (broker-kill 2)",
   "fontSize": 15.5,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.28,
   "autoResize": true
  },
  {
   "id": "text-34",
   "type": "text",
   "x": 472,
   "y": 434,
   "width": 313.5,
   "height": 138.2,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 56502658,
   "version": 1,
   "versionNonce": 56497598,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Apenas 1 de 3 vivo -> ISR = [1]\n\nISR (1) < min.insync.replicas (2)!\nBroker recusa escritas com acks=all\n(NotEnoughReplicasException).\nProdutor resiliente entra em retry.\n\nResultado: protege contra perda silenciosa!",
   "originalText": "Apenas 1 de 3 vivo -> ISR = [1]\n\nISR (1) < min.insync.replicas (2)!\nBroker recusa escritas com acks=all\n(NotEnoughReplicasException).\nProdutor resiliente entra em retry.\n\nResultado: protege contra perda silenciosa!",
   "fontSize": 13.5,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.28,
   "autoResize": true
  },
