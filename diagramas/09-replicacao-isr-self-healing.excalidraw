   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "1. Cai 1 broker (broker-kill 3)",
   "originalText": "1. Cai 1 broker (broker-kill 3)",
   "fontSize": 15.5,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.28,
   "autoResize": true
  },
  {
   "id": "text-31",
   "type": "text",
   "x": 62,
   "y": 434,
   "width": 298.9,
   "height": 121.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 683129967,
   "version": 1,
   "versionNonce": 683114579,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "ISR encolhe: [1, 2, 3] -> [1, 2]\n\nISR (2) >= min.insync.replicas (2)\nController KRaft elege novos lideres\npara particoes que estavam no broker3.\n\nResultado: ZERO perda, operacao continua!",
   "originalText": "ISR encolhe: [1, 2, 3] -> [1, 2]\n\nISR (2) >= min.insync.replicas (2)\nController KRaft elege novos lideres\npara particoes que estavam no broker3.\n\nResultado: ZERO perda, operacao continua!",
   "fontSize": 13.5,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.28,
   "autoResize": true
  },
  {
   "id": "rect-32",
